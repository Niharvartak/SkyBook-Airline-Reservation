# Copy to .env and replace every placeholder with a unique random value.
MYSQL_DATABASE=skybook
MYSQL_USER=skybook_app
MYSQL_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_PASSWORD
# Managed MySQL (Aiven, etc.) usually requires TLS.
MYSQL_SSL=false
MYSQL_SSL_CA=
MYSQL_SSL_CA_BASE64=
MYSQL_SSL_REJECT_UNAUTHORIZED=true
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
SKYBOOK_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SKYBOOK_BIND_ADDRESS=127.0.0.1
SKYBOOK_HTTP_PORT=8081
VITE_API_URL=
# Public base URL used in password-reset links (no trailing slash).
APP_BASE_URL=http://localhost:5173
# Fare-watch scheduler cadence in minutes (database fares only).
FARE_WATCH_INTERVAL_MINUTES=30
# Development-only administrator seed fallback. Change for any shared environment.
# The value is hashed by db-schema.js; it is never sent to the frontend.
SKYBOOK_DEV_ADMIN_PASSWORD=Admin@123
# Production bootstrap administrator. The Docker entrypoint rotates the seeded
# admin to this password before the API starts. Must be at least 12 characters.
SKYBOOK_ADMIN_EMAIL=admin@skybook.com
SKYBOOK_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_ADMIN_PASSWORD
# Optional demo customer for Docker. Leave empty to disable the seeded demo
# account; set a strong value only for a deliberate demo deployment.
SKYBOOK_DEMO_PASSWORD=
# Local/demo stacks only: allow the documented demo passwords in production mode.
SKYBOOK_ALLOW_DEMO_ACCOUNTS=false
# Set true only when this Node process serves the built SPA (Render single
# container). Docker Compose uses Nginx and leaves this false.
SERVE_FRONTEND=false