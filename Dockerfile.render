# Single-container image for Render/Cloud Run/Fly-style hosts.
# Nginx is still used by docker-compose for local/self-hosted deployments; this
# image lets one Node process serve the built SPA and the API on the same origin.
FROM node:22-bookworm-slim AS frontend

WORKDIR /app

RUN apt-get update \
	&& apt-get install -y --no-install-recommends python3 make g++ \
	&& rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
ARG VITE_API_URL=
ENV VITE_API_URL=${VITE_API_URL}
RUN npm run build

FROM node:22-bookworm-slim AS runtime

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=8080
ENV HOST=0.0.0.0
ENV SERVE_FRONTEND=true

COPY src/backend/package.json src/backend/package-lock.json ./src/backend/
RUN cd src/backend && npm ci --omit=dev

COPY src/backend/ ./src/backend/
COPY database/skybook.sql ./database/skybook.sql
COPY --from=frontend /app/dist ./dist

RUN chmod +x /app/src/backend/docker-entrypoint.sh

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
  CMD node -e "require('http').get('http://127.0.0.1:'+(process.env.PORT||8080)+'/api/health',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"

ENTRYPOINT ["/app/src/backend/docker-entrypoint.sh"]
CMD ["node", "src/backend/server.js"]
