FROM node:22-bookworm-slim

WORKDIR /app

# Install native build tools for better-sqlite3
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

# Copy only backend dependencies first (layer caching)
COPY package.json package-lock.json ./
RUN npm ci

# Copy backend source
COPY src/backend/ ./src/backend/

# Create persistent data directory and copy existing DB as seed if present
RUN mkdir -p /app/data

# Startup script that copies seed DB on first run
COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

EXPOSE 8080

ENV NODE_ENV=production
ENV PORT=8080
ENV DB_PATH=/app/data/skybook.db

ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["node", "src/backend/server.js"]
