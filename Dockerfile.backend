FROM node:22-bookworm-slim

WORKDIR /app

# Copy only backend dependencies first (layer caching).
# mysql2/bcryptjs are pure JS — no native build tools required.
COPY src/backend/package.json src/backend/package-lock.json ./src/backend/
RUN cd src/backend && npm ci --omit=dev

# Copy backend source and the schema/seed file
COPY src/backend/ ./src/backend/
COPY database/skybook.sql ./database/skybook.sql

# The entrypoint is copied from Windows in some checkouts, where the executable
# bit is not preserved. Make it explicit so Docker can exec it.
RUN chmod +x /app/src/backend/docker-entrypoint.sh

EXPOSE 8080

ENV NODE_ENV=production
ENV PORT=8080
ENV HOST=0.0.0.0
ENV SERVE_FRONTEND=false

ENTRYPOINT ["/app/src/backend/docker-entrypoint.sh"]
CMD ["node", "src/backend/server.js"]
